{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ctrl+",
  "version": "0.1.7",
  "identifier": "com.alexd.ctrlplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ctrl+",
        "width": 560,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "resizable": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Multi-clipboard manager for Windows",
    "longDescription": "ctrl+ keeps your clipboard history and lets you paste any previous item with a global hotkey. All data stays local on your machine.",
    "category": "Utility",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
